# Maintainer: heyquatch <70372296+heyquatch@users.noreply.github.com>
pkgname=plasmify
pkgver=0.1.1
pkgrel=1
pkgdesc="One-click, bloat-free desktop themes for KDE Plasma 6"
arch=('any')
url="https://github.com/heyquatch/plasmify"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyqt6' 'git' 'plasma-workspace' 'kconfig' 'qt6-tools')
optdepends=('kvantum: application styles used by some presets'
            'papirus-icon-theme: icon theme used by the bundled presets')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$pkgname-$pkgver"
    PYTHONPATH=src python -m unittest discover -s tests -t .
}

package() {
    cd "$pkgname-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 data/io.github.heyquatch.plasmify.desktop \
        "$pkgdir/usr/share/applications/io.github.heyquatch.plasmify.desktop"
    install -Dm644 src/plasmify/assets/plasmify.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.heyquatch.plasmify.svg"
}
